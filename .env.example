# ==============================================================================
# Code-Runner Environment Configuration
# Shared across local native development and containerized Docker stacks
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coderunner
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coderunner
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:postgres@postgres:5432/coderunner?sslmode=disable

# ------------------------------------------------------------------------------
# Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Dashboard API Service
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8080
DASHBOARD_PORT=8080
JWT_SECRET=cr_dev_jwt_super_secret_key_change_in_prod
TOKEN_TTL_HOURS=72
ENGINE_URL=http://execution-engine:8081
DEV_BYPASS_KEY=cr_dev_bypass_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Execution Engine Service
# ------------------------------------------------------------------------------
ENGINE_PORT=8081
NUM_WORKERS=4
EXECUTION_DRIVER=local

# ------------------------------------------------------------------------------
# Internal Service-to-Service Secret
# ------------------------------------------------------------------------------
INTERNAL_SERVICE_SECRET=sec_local_dev_internal_token_99a8b7
