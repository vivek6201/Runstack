# ==============================================================================
# Code-Runner Firecracker MicroVM Configuration
# Overrides when running with microVM isolation (Linux KVM)
# ==============================================================================

EXECUTION_DRIVER=firecracker
NUM_WORKERS=2
FIRECRACKER_BIN=/opt/firecracker/firecracker
FIRECRACKER_KERNEL=/opt/firecracker/vmlinux
FIRECRACKER_KERNEL_PATH=/opt/firecracker/vmlinux
FIRECRACKER_ROOTFS=/opt/firecracker/rootfs.ext4
FIRECRACKER_ROOTFS_PATH=/opt/firecracker/rootfs.ext4
FIRECRACKER_SOCKET_DIR=/tmp
FIRECRACKER_POOL_SIZE=2
